# Copy this file to .env and replace both placeholders locally.
# Keep credentials in .env; never commit that file.
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
MONGODB_DATABASE=YOUR_SANDBOX_DATABASE_NAME
# Enter your OpenAI key only in the ignored local .env.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
# Hosting dashboard only: explicitly reuse the EVENT Atlas settings.
# CATALOG_MONGODB_URI=YOUR_EXISTING_EVENT_ATLAS_CONNECTION_STRING
# CATALOG_MONGODB_DATABASE=YOUR_EXISTING_EVENT_DATABASE_NAME
# Optional server-side Raindrop telemetry; never expose these in browser code.
# RAINDROP_WRITE_KEY=YOUR_RAINDROP_SDK_WRITE_KEY
# RAINDROP_PROJECT_ID=catalog-harness-demo
# Optional separate read key for receipt verification; never use the write key here.
# RAINDROP_QUERY_API_KEY=YOUR_RAINDROP_QUERY_API_KEY
RAINDROP_WRITE_KEY=
