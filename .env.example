# Copy to the ignored .env without overwriting existing credentials.
# Local demo: reuse the existing event-provided Atlas database.
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
MONGODB_DATABASE=YOUR_SANDBOX_DATABASE_NAME

# Optional for explicit model-running tools; not needed to view saved results.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Hosting dashboard only: explicitly reuse the same event Atlas settings.
# CATALOG_MONGODB_URI=YOUR_EXISTING_EVENT_ATLAS_CONNECTION_STRING
# CATALOG_MONGODB_DATABASE=YOUR_EXISTING_EVENT_DATABASE_NAME

# Optional server-side Raindrop upload and project selection.
RAINDROP_WRITE_KEY=
RAINDROP_PROJECT_ID=
# Separate read key for verification; the write key cannot replace it.
RAINDROP_QUERY_API_KEY=
